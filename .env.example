# Local development. scripts/serve_local.py sets sensible defaults for all of
# these; copy to .env only if you want to override something.

# Storage: "local" (JSON file) or "dynamodb"
BW_STORE=local
BW_LOCAL_DIR=.local
# BW_TABLE=batchwatch-dev

# Claude on Bedrock: auto | on | off
BW_BEDROCK=auto
BW_BEDROCK_MODEL=anthropic.claude-opus-5
BW_BEDROCK_REGION=us-east-1

# Identity. "1" accepts an X-Device-Id header (a namespace, not a security
# boundary). Deployed with RequireLogin=true this is "0" and identity comes
# from the Cognito JWT.
BW_ALLOW_DEVICE_ID=1

# Protects POST /admin/ingest
BW_ADMIN_KEY=local-dev-key

# Email alerts. Empty disables SES and leaves in-app alerts working.
BW_SES_FROM=

# Matching thresholds - the descope ladder changes these, not the code.
# BW_FLAG_THRESHOLD=0.92
# BW_REVIEW_THRESHOLD=0.74
